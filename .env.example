# NTUST Course Scraper Bot - Environment Variables
# Phase 2 Configuration

# ==================== REQUIRED ====================
# Discord Bot Token (從 Discord Developer Portal 取得)
TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# ==================== OPTIONAL ====================
# 除錯模式（開發環境：True，生產環境：False）
DEBUG=True

# Worker Pool 大小（並行查詢的 Worker 數量）
# 建議值：
#   1-20 門課程：3
#   21-50 門課程：5 (預設)
#   51-100 門課程：10
#   100+ 門課程：15
WORKER_POOL_SIZE=5

# 課程查詢間隔（秒）
# 建議值：5-20 秒（太頻繁可能觸發 rate limiting）
POLLING_INTERVAL=10

# 定期通知間隔（分鐘）
# 當課程有名額時，持續提醒的間隔
NOTIFICATION_INTERVAL=1

# 資料檔案路徑
# 本地部署：courses.json
# GCP 部署：建議使用絕對路徑指向持久化儲存（例如：/home/user/data/courses.json）
DATA_FILE=courses.json

# 定期清除追蹤課程日期（每年重複）
# 格式：月-日,月-日,月-日（例如：01-15,07-01,09-15）
# 在這些日期會自動清除所有伺服器的追蹤課程（因應學期更新）
# 留空則不啟用自動清除功能
# 建議設定：01-15（寒假後），07-01（暑假開始），09-15（新學期前）
CLEANUP_DATES=

# ==================== NOTES ====================
# 1. TOKEN 是必須設定的，其他都有預設值
# 2. 生產環境建議 DEBUG=False 以減少日誌量
# 3. GCP 部署時透過環境變數或 Secret Manager 設定這些變數
# 4. 不要將此檔案的 TOKEN 設為真實值並提交到 Git
# 5. CLEANUP_DATES 可設定每年清除追蹤課程的日期（例如學期更新時）
# 6. GCP 部署時建議設定 TZ=Asia/Taipei 以確保 CLEANUP_DATES 以台灣時間觸發
