# NTUST Course Scraper Bot - Environment Variables
# Phase 2 Configuration

# ==================== REQUIRED ====================
# Discord Bot Token (從 Discord Developer Portal 取得)
TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# ==================== OPTIONAL ====================
# 除錯模式（開發環境：True，生產環境：False）
DEBUG=True

# Worker Pool 大小（並行查詢的 Worker 數量）
# 建議值：
#   1-20 門課程：3
#   21-50 門課程：5 (預設)
#   51-100 門課程：10
#   100+ 門課程：15
WORKER_POOL_SIZE=5

# 課程查詢間隔（秒）
# 建議值：5-20 秒（太頻繁可能觸發 rate limiting）
POLLING_INTERVAL=10

# 定期通知間隔（分鐘）
# 當課程有名額時，持續提醒的間隔
NOTIFICATION_INTERVAL=1

# 資料檔案路徑
# 本地部署：courses.json
# GCP 部署：建議使用絕對路徑指向持久化儲存（例如：/home/user/data/courses.json）
DATA_FILE=courses.json

# 選課期間設定（選填，設定後 Bot 僅在期間內啟用課程輪詢）
# 格式：MM-DD~MM-DD，多組用逗號分隔（例如：03-17~03-28,09-15~10-05）
#   - 選課前（before）：可加入追蹤、可查詢，不啟動輪詢
#   - 選課中（active）：完整輪詢與通知功能啟用
#   - 選課結束（after）：自動清除追蹤清單，停止輪詢
# 留空則不啟用日期限制（維持永遠輪詢的舊行為）
TRACKING_PERIODS=

# ==================== NOTES ====================
# 1. TOKEN 是必須設定的，其他都有預設值
# 2. 生產環境建議 DEBUG=False 以減少日誌量
# 3. GCP 部署時透過環境變數或 Secret Manager 設定這些變數
# 4. 不要將此檔案的 TOKEN 設為真實值並提交到 Git
# 5. TRACKING_PERIODS 可設定每學期的選課期間（例如：03-17~03-28,09-15~10-05）
# 6. GCP 部署時建議設定 TZ=Asia/Taipei 以確保選課期間以台灣時間判斷
